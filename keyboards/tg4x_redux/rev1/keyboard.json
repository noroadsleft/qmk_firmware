{
    "keyboard_name": "TG4x rev1",
    "manufacturer": "You",
    "url": "https://github.com/MythosMann/tg4x",
    "maintainer": "qmk",
    "usb": {
        "vid": "0xFEED",
        "pid": "0x0000",
        "device_version": "0.0.1"
    },
    "development_board": "promicro",
    "matrix_pins": {
        "rows": ["D3", "D1", "F5", "F4"],
        "cols": ["B5", "B4", "E6", "D7", "C6", "D4", "D0", "D2", "F6", "F7", "B1", "B3", "B2"]
    },
    "diode_direction": "COL2ROW",
    "debounce": 5,
    "features": {
        "bootmagic": false,
        "mousekey": true,
        "extrakey": true,
        "console": false,
        "command": false,
        "nkro": true,
        "backlight": false,
        "rgblight": true,
        "tap_dance": true
    },
    "qmk": {
        "locking": {
            "enabled": true,
            "resync": true
        }
    },
    "rgblight": {
        "led_count": 7,
        "hue_steps": 8,
        "saturation_steps": 8,
        "brightness_steps": 8,
        "max_brightness": 255
    },
    "ws2812": {
        "pin": "B6"
    },
    "layout_aliases": {
        "LAYOUT": "LAYOUT_tg3"
    },
    "layouts": {
        "LAYOUT_tg3": {
            "layout": [
                {"label": "Esc", "matrix": [0, 0], "x": 0, "y": 0},
                {"label": "Q", "matrix": [0, 1], "x": 1, "y": 0},
                {"label": "W", "matrix": [0, 2], "x": 2, "y": 0},
                {"label": "E", "matrix": [0, 3], "x": 3, "y": 0},
                {"label": "R", "matrix": [0, 4], "x": 4, "y": 0},
                {"label": "T", "matrix": [0, 5], "x": 5, "y": 0},
                {"label": "Y", "matrix": [0, 6], "x": 6, "y": 0},
                {"label": "U", "matrix": [0, 7], "x": 7, "y": 0},
                {"label": "I", "matrix": [0, 8], "x": 8, "y": 0},
                {"label": "O", "matrix": [0, 9], "x": 9, "y": 0},
                {"label": "P", "matrix": [0, 10], "x": 10, "y": 0},
                {"label": "'", "matrix": [0, 11], "x": 11, "y": 0},
                {"label": "Delete", "matrix": [0, 12], "x": 12, "y": 0},
                {"label": "Caps Lock", "matrix": [1, 0], "x": 0, "y": 1, "w": 1.25},
                {"label": "A", "matrix": [1, 1], "x": 1.25, "y": 1},
                {"label": "S", "matrix": [1, 2], "x": 2.25, "y": 1},
                {"label": "D", "matrix": [1, 3], "x": 3.25, "y": 1},
                {"label": "F", "matrix": [1, 4], "x": 4.25, "y": 1},
                {"label": "G", "matrix": [1, 5], "x": 5.25, "y": 1},
                {"label": "H", "matrix": [1, 6], "x": 6.25, "y": 1},
                {"label": "J", "matrix": [1, 7], "x": 7.25, "y": 1},
                {"label": "K", "matrix": [1, 8], "x": 8.25, "y": 1},
                {"label": "L", "matrix": [1, 9], "x": 9.25, "y": 1},
                {"label": ":", "matrix": [1, 10], "x": 10.25, "y": 1},
                {"label": "&crarr;", "matrix": [1, 11], "x": 11.25, "y": 1, "w": 1.75},
                {"label": "&uArr;", "matrix": [2, 0], "x": 0, "y": 2, "w": 1.75},
                {"label": "Z", "matrix": [2, 1], "x": 1.75, "y": 2},
                {"label": "X", "matrix": [2, 2], "x": 2.75, "y": 2},
                {"label": "C", "matrix": [2, 3], "x": 3.75, "y": 2},
                {"label": "V", "matrix": [2, 4], "x": 4.75, "y": 2},
                {"label": "B", "matrix": [2, 5], "x": 5.75, "y": 2},
                {"label": "N", "matrix": [2, 6], "x": 6.75, "y": 2},
                {"label": "M", "matrix": [2, 7], "x": 7.75, "y": 2},
                {"label": "<", "matrix": [2, 8], "x": 8.75, "y": 2},
                {"label": ">", "matrix": [2, 9], "x": 9.75, "y": 2},
                {"label": "?", "matrix": [2, 10], "x": 10.75, "y": 2},
                {"label": "&uArr;", "matrix": [2, 11], "x": 11.75, "y": 2, "w": 1.25},
                {"label": "Ctrl", "matrix": [3, 0], "x": 0, "y": 3},
                {"label": "Alt", "matrix": [3, 1], "x": 1, "y": 3},
                {"label": "Tab", "matrix": [3, 2], "x": 2, "y": 3},
                {"label": "K35", "matrix": [3, 5], "x": 3, "y": 3, "w": 6},
                {"label": "Fn", "matrix": [3, 8], "x": 9, "y": 3},
                {"label": "&larr;", "matrix": [3, 9], "x": 10, "y": 3},
                {"label": "&uarr;", "matrix": [3, 10], "x": 11, "y": 3},
                {"label": "&rarr;", "matrix": [3, 11], "x": 12, "y": 3}
            ]
        }
    }
}
